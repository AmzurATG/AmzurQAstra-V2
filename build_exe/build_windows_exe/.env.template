# ============================================
# QAstra Configuration
# Fill in the values below, then double-click QAstra.exe
# ============================================

# ============================================
# Server
# ============================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ============================================
# Database (required)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qastra
DB_USER=qastra
DB_PASSWORD=CHANGE-ME
DATABASE_URL=postgresql+asyncpg://qastra:CHANGE-ME@localhost:5432/qastra
# Schema per stakeholder (each user gets their own schema in the same DB)
DB_SCHEMA=qastraschema

# ============================================
# Redis (optional)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Security (required)
# ============================================
# Generate random values: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-ME
ENCRYPTION_KEY=CHANGE-ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_NONCE=CHANGE-ME

# ============================================
# LLM Provider Configuration (at least one required)
# ============================================
DEFAULT_LLM_PROVIDER=litellm

# LiteLLM Proxy
LITELLM_API_KEY=your-key
LITELLM_API_BASE=http://your-litellm-proxy:4000/v1
LITELLM_MODEL=gemini/gemini-2.5-flash
LITELLM_FALLBACK_MODELS=gpt-4o,gpt-4o-mini,gemini/gemini-2.0-flash

# Direct provider keys (alternative to LiteLLM proxy):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# Browser Automation (Steel + Playwright)
# ============================================
BROWSER_ENGINE=steel
STEEL_API_KEY=your-steel-api-key
STEEL_USE_WITH_PLAYWRIGHT=true

# Browser-use agent (uses LiteLLM proxy + vision model)
BROWSER_USE_LLM_BACKEND=litellm
BROWSER_USE_LLM_TEMPERATURE=0.15
# BROWSER_USE_LLM_MODEL=gemini/gemini-2.5-flash  # defaults to LITELLM_MODEL
BROWSER_USE_CAPTURE_SCREENSHOTS=true

# ============================================
# Integrations (optional)
# ============================================

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Azure DevOps
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PAT=

# Slack
SLACK_WEBHOOK_URL=

# ============================================
# Document Storage
# ============================================
# Storage type: 'local', 's3', or 'supabase'
STORAGE_TYPE=local

# Local Storage (path outside backend folder to prevent uvicorn restart)
STORAGE_LOCAL_PATH=../storage

# AWS S3 Storage (uncomment to use)
# STORAGE_S3_BUCKET=your-bucket-name
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_ENDPOINT_URL=  # For S3-compatible services (MinIO, DigitalOcean, etc.)
# STORAGE_S3_PREFIX=uploads

# Supabase Storage (uncomment to use)
# STORAGE_SUPABASE_URL=https://your-project.supabase.co
# STORAGE_SUPABASE_KEY=your-service-role-key
# STORAGE_SUPABASE_BUCKET=documents
# STORAGE_SUPABASE_PREFIX=

# Logging (outside backend/ to prevent uvicorn restart)
LOG_DIR=../logs

# Screenshots (outside backend/ to prevent uvicorn restart)
SCREENSHOTS_DIR=../screenshots

# Legacy File Storage (backward compatibility)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ============================================
# Default Admin Account
# ============================================
ADMIN_EMAIL=admin@qastra.dev
ADMIN_PASSWORD=change-me-on-first-login

# ============================================
# Email / SMTP (optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=30
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=QAstra
